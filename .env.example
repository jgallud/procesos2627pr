# Copia este archivo como .env y rellena los valores (el .env NO se sube al repositorio).

# Puerto HTTP del servidor (Cloud Run lo fija automáticamente)
PORT=3000

# Entorno de ejecución: development | production | test
NODE_ENV=development

# Nivel de log: debug | info | warn | error | silent
LOG_LEVEL=info

# Email del administrador inicial (se crea o promueve al arrancar el servidor)
ADMIN_EMAIL=

# Contraseña del administrador inicial (secreto, mínimo 8 caracteres)
ADMIN_PASSWORD=

# URL pública de la aplicación (para construir el enlace de confirmación de cuenta)
APP_URL=http://localhost:3000

# Duración de la sesión en horas (por defecto 168 = 7 días)
SESION_HORAS=168
