# Copia este archivo como .env y rellena los valores (el .env NO se sube al repositorio).

# Puerto HTTP del servidor (Cloud Run lo fija automáticamente)
PORT=3000

# Entorno de ejecución: development | production | test
NODE_ENV=development

# Nivel de log: debug | info | warn | error | silent
LOG_LEVEL=info

# Cadena de conexión de MongoDB Atlas (secreto: incluye usuario y contraseña).
# Atlas -> Connect -> Drivers. Si se deja vacía, los datos se guardan en memoria
# (solo para desarrollo: se pierden al reiniciar). En producción es obligatoria.
MONGODB_URI=

# Nombre de la base de datos dentro del cluster (por defecto procesos2627pr)
MONGODB_DB=procesos2627pr

# Email del administrador inicial (se crea o promueve al arrancar el servidor)
ADMIN_EMAIL=

# Contraseña del administrador inicial (secreto, mínimo 8 caracteres)
ADMIN_PASSWORD=

# URL pública de la aplicación (para construir el enlace de confirmación de cuenta).
# Obligatoria en producción y con https://; sin ella el servidor no arranca.
APP_URL=http://localhost:3000

# Duración de la sesión en horas (por defecto 168 = 7 días)
SESION_HORAS=168

# Correo de confirmación con Brevo (Hito 4).
# Clave del API de Brevo (secreto). Si se deja vacía, el enlace de confirmación
# se escribe en el log del servidor en lugar de enviarse por correo.
BREVO_API_KEY=

# Dirección remitente, verificada en Brevo (obligatoria si hay BREVO_API_KEY)
CORREO_REMITENTE=

# Nombre del remitente que verá el usuario (por defecto procesos2627pr)
CORREO_REMITENTE_NOMBRE=

# Inicio de sesión con Google (Hito 4). Sin estas dos variables no se ofrece.
# URI de redirección que hay que autorizar en Google: APP_URL/api/oauth/google/retorno
GOOGLE_CLIENT_ID=

# Secreto de cliente OAuth de Google (secreto)
GOOGLE_CLIENT_SECRET=
